    <string name="home_service_active_title">Detection active</string>
    <string name="home_service_off_title">Detection is off</string>
    <string name="home_service_active_body">ScrollKill can see when an infinite feed opens.</string>
    <string name="home_service_off_body">ScrollKill needs the accessibility service to notice feeds. Nothing is stored or sent anywhere.</string>
