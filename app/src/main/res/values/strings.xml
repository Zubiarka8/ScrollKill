    <string name="app_name">ScrollKill</string>
    <string name="accessibility_service_label">ScrollKill detection</string>
    <string name="accessibility_service_description">Lets ScrollKill notice when an infinite feed opens so it can help you stop scrolling. Screen contents are read on-device only, never stored and never sent anywhere.</string>

    <!-- Shared: the BACK-press intervention toggle (Home and Settings) -->
    <string name="nudge_toggle_title">Nudge me off feeds</string>
    <string name="nudge_toggle_subtitle">Press Back automatically when a feed is detected.</string>

    <!-- Toast shown by the accessibility service right after the BACK-press intervention. %1$s is the app name. -->
    <string name="intervention_toast_limit_reached">Daily limit reached for %1$s</string>
    <string name="intervention_toast_blocked">%1$s feed closed</string>

