<?xml version="1.0" encoding="utf-8"?>
<!--
  Config for ScrollKillAccessibilityService.
  - flagReportViewIds: required for AccessibilityNodeInfo.viewIdResourceName,
    one of the detection signals.
  - notificationTimeout: framework-level throttle for content-change bursts.
  - packageNames is intentionally omitted: the watched set will become
    user-configurable at runtime via setServiceInfo(), and code filters it
    on every event anyway.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="100"
    android:description="@string/accessibility_service_description" />
