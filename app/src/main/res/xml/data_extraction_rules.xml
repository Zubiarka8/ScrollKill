<?xml version="1.0" encoding="utf-8"?><!--
   Backup / transfer rules for devices on API 31 and above.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Session history stays on-device (CLAUDE.md: keep user data local, no cloud). -->
        <exclude domain="database" path="scrollkill.db" />
    </cloud-backup>
</data-extraction-rules>
