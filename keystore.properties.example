# Copy to keystore.properties at the repo root and fill in the real values.
# keystore.properties is git-ignored and is read by app/build.gradle.kts to sign the
# release build. If it is absent the release APK is simply left unsigned.
#
# Create the keystore once with:
#   keytool -genkeypair -v -keystore scrollkill-release.jks -alias scrollkill \
#           -keyalg RSA -keysize 2048 -validity 10000

storeFile=../scrollkill-release.jks
storePassword=CHANGE_ME
keyAlias=scrollkill
keyPassword=CHANGE_ME
